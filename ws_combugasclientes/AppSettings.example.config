<appSettings>
  <add key="URLSITIO" value="REEMPLAZAR_URL" />
  <add key="PUERTOSITIO" value="REEMPLAZAR_PUERTO" />
  <!-- Origen público que hospeda /Images/productos. Configurarlo cuando IIS esté detrás de un proxy o balanceador. -->
  <add key="UrlPublica" value="https://api.midominio.com/" />
  <add key="IconoProductoPredeterminado" value="/Images/productos/default.webp" />
  <add key="Productivo_online" value="0" />
  <add key="Productivo_online_luis" value="0" />
  <add key="metros_minimos" value="80" />
  <add key="direcAct" value="1" />
  <add key="KEY_MAPS" value="REEMPLAZAR_CLAVE" />
  <add key="TWILIO_ACCOUNT_SID" value="REEMPLAZAR_ACCOUNT_SID" />
  <add key="TWILIO_AUTH_TOKEN" value="REEMPLAZAR_AUTH_TOKEN" />
  <add key="tel01" value="80" />
  <add key="tel02" value="80" />
  <add key="tel03" value="80" />
  <add key="tel04" value="80" />
  <add key="tel05" value="80" />
</appSettings>
